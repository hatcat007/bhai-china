generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 销售线索：预约请求（source=booking）+ AI 路线图生成（source=roadmap）
model Lead {
  id            String   @id @default(cuid())
  name          String
  contact       String // 微信号或邮箱
  brand         String?
  revenueRange  String?
  stage         String?
  painPoint     String?
  chinaPresence String?
  message       String?
  roadmapMd     String? // LLM 生成的完整 14 周路线图（Markdown）
  source        String   @default("booking") // booking | roadmap
  status        String   @default("new") // new | contacted | qualified | closed
  createdAt     DateTime @default(now())

  @@index([source, createdAt])
}

// 新闻通讯订阅
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// 邮件发件队列（outbox 模式）：路线图生成后入队，SMTP 接入后由 worker 消费发送
model EmailOutbox {
  id        String   @id @default(cuid())
  to        String // 收件邮箱
  subject   String
  bodyMd    String // Markdown 正文（完整路线图）
  leadId    String? // 关联线索
  status    String   @default("queued") // queued | sent | failed
  error     String? // 发送失败原因
  createdAt DateTime @default(now())
  sentAt    DateTime?

  @@index([status, createdAt])
}

// 行为漏斗埋点（轻量、无 PII）：扫描/工具运行/解锁转化分析
model TrackEvent {
  id        String   @id @default(cuid())
  name      String // scan_start | scan_complete | scan_fail | tool_start | tool_complete | tool_error | unlock_modal | unlock_success | shot_fallback
  tool      String? // 工具 slug（站点级事件为空）
  meta      String? // 短摘要（≤120 字，不含用户输入原文）
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([tool, createdAt])
}
